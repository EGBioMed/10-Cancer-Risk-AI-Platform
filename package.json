{
  "name": "eg-biomed-cancer-risk-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "EG BioMed AI cancer risk interactive assessment platform.",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test-contract.js test-questionnaire-ui.js test-local-repository.js",
    "validate:contract": "node --test test-contract.js",
    "generate:answer-codes": "node scripts/generate-answer-code-manifest.js",
    "backup:local": "node scripts/backup-local-data.js",
    "export:research": "node scripts/export-local-data.js --dataset research --output local-exports/research.csv",
    "export:contacts": "node scripts/export-local-data.js --dataset contacts --output local-exports/contacts.csv"
  },
  "engines": {
    "node": ">=24"
  }
}

{
  "name": "eg-biomed-cancer-risk-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "EG BioMed AI cancer risk interactive assessment platform.",
  "scripts": {
    "start": "node server.js",
    "start:postgres": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-postgres-local.ps1",
    "test": "node --test test-contract.js test-questionnaire-ui.js test-submission-e2e.js test-asset-version.js test-postgres-repository.js test-backup-retention.js test-access-gate.js test-rate-limiter.js test-azure-access-gate-client.js",
    "validate:contract": "node --test test-contract.js",
    "generate:answer-codes": "node scripts/generate-answer-code-manifest.js",
    "generate:power-automate-trigger-schema": "node scripts/generate-power-automate-trigger-schema.js",
    "generate:questionnaire-review": "node scripts/generate-questionnaire-review.js",
    "generate:questionnaire-review-docx": "node scripts/build-questionnaire-review-docx.js",
    "backup:local": "node scripts/backup-postgres.js",
    "export:research": "node scripts/export-postgres-data.js --dataset research --output local-exports/research.csv",
    "export:contacts": "node scripts/export-postgres-data.js --dataset contacts --output local-exports/contacts.csv",
    "access:export": "node scripts/export-access-grants.js",
    "access:grant": "node scripts/grant-access.js",
    "access:topup": "node scripts/topup-access-code.js",
    "access:status": "node scripts/access-code-status.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "docx": "^9.7.1"
  }
}

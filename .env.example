# Local on-premises PostgreSQL mode
SUBMISSION_MODE=postgres
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=cancer_risk
PGUSER=cancer_app_writer
PGPASSWORD=use-a-local-secret-not-committed-to-git
PGPOOL_MAX=20
# Set true only when intentionally running migrations with a database owner account.
RUN_DATABASE_MIGRATIONS=false
HOST=127.0.0.1
PORT=3000

# Temporary rollback modes only: power-automate or dual
# POWER_AUTOMATE_WEBHOOK_URL=https://...

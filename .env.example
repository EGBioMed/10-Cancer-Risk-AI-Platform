# Local on-premises PostgreSQL mode
SUBMISSION_MODE=postgres
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=cancer_risk
PGUSER=cancer_app_writer
PGPASSWORD=use-a-local-secret-not-committed-to-git
PGPOOL_MAX=20
# Set true only when intentionally running migrations with a database owner account.
RUN_DATABASE_MIGRATIONS=false
HOST=127.0.0.1
PORT=3000

# Temporary rollback modes only: power-automate or dual
# POWER_AUTOMATE_WEBHOOK_URL=https://...

# Payment-confirmation access gate. The code's own default (when this is
# unset) is "enforced" (fail-closed) -- "open" here is a deliberate
# developer-convenience override for local work and must never be carried
# into a production .env or the Windows service's runtime env file.
ACCESS_GATE_MODE=open
# Required whenever ACCESS_GATE_MODE=enforced. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ACCESS_GATE_SESSION_SECRET=
# Session length in hours after a link is redeemed (0.5 = 30 minutes).
ACCESS_GATE_SESSION_TTL_HOURS=0.5
# Set to false only for local HTTP testing without TLS.
ACCESS_GATE_COOKIE_SECURE=true
# Used by scripts/grant-access.js to print the full /access/<token> URL.
PUBLIC_BASE_URL=https://192.168.12.22

# Which backend answers the access gate: "postgres" (default) or
# "azure_mysql" (talks to egbiomed-ai-data-api instead -- see
# ACCESS_GATE.md#storage-backend-postgres-or-azure-mysql). Leave unset for
# unchanged current behavior. The two vars below are only read when this is
# "azure_mysql" -- never put the real production key here in a local .env;
# use ACCESS_GATE_MODE=open for local development instead.
ACCESS_GATE_BACKEND=postgres
AZURE_ACCESS_GATE_API_BASE_URL=
AZURE_ACCESS_GATE_API_KEY=

# The institution whitelist: which entrances deliver every report to one
# institutional mailbox instead of to the person who answered. One entry per
# institution, keyed by a slug, listing the access codes that institution
# enters under -- so a re-minted code is appended to the same entry instead of
# re-keying the whole thing. `grants` is optional and only needed for a
# single-use /access/<token> link, which carries no code.
#
# `label` is shown to the respondent ("your report will be sent to X"), so it
# is required. A code claimed by two institutions routes to neither. A
# malformed entry is logged and dropped; the server still starts, and that
# entrance goes back to asking the respondent for an address.
#
# See ACCESS_GATE.md#where-an-institutions-reports-go.
#   INSTITUTION_REPORT_RECIPIENTS={"shuangho":{"label":"雙和醫院","email":"reports@example.org","codes":["egshuangho2026"]}}
INSTITUTION_REPORT_RECIPIENTS=

# The JoiiUp hand-off entrance (GET /sso/joiiup?token=...). All four of the
# first block are required together -- with any of them missing the entrance
# is disabled and every request to it gets the "link expired" page, which is
# also what happens if a key fails to parse. Leave them unset here: the
# partner's public key and the enterprise codes belong in the deployment's
# own environment, not in a file in the repository.
#
# ALGORITHMS is OUR list, not the token's. The token's header may only match
# one of these; it never chooses. Comma-separated.
SSO_JOIIUP_ALGORITHMS=
# kid -> PEM public key, as JSON. Two entries during a key rotation; with
# exactly one, a token may omit its kid.
#   SSO_JOIIUP_KEYS={"2026-a":"-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n"}
SSO_JOIIUP_KEYS=
# The iss claim we accept, exactly.
SSO_JOIIUP_ISSUER=
# Their enterprise id -> the access code that enterprise enters under, as
# JSON. One code per enterprise is what buys per-enterprise use counts and
# quotas without a new column anywhere. An org that is not listed cannot get
# in, which is the correct answer to "they signed up a client we were never
# told about".
#   SSO_JOIIUP_ORG_GRANTS={"ACME":"<access code>"}
SSO_JOIIUP_ORG_GRANTS=

# Optional. The aud claim, when they add one.
SSO_JOIIUP_AUDIENCE=
# Optional. Their app's deep link, shown as "back to the app" on the failure
# page. Unset means no button rather than a dead one.
SSO_JOIIUP_DEEP_LINK=
# Default true: a token with no jti is refused, because without one there is
# nothing to deduplicate on and replay protection is absent rather than weak.
# Set to false only as a deliberate, temporary decision while the partner
# adds the field.
SSO_JOIIUP_REQUIRE_JTI=true
# Default false, and nothing reads it yet -- setting it true only logs that
# it is not honoured. Keeping their user id would give our records a foreign
# key into their user base; that is an IRB-level decision, not a default.
SSO_JOIIUP_STORE_SUBJECT=false

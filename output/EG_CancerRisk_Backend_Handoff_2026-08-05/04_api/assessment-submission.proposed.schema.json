{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eg-bio.com/contracts/v1/assessment-submission.schema.json",
  "title": "EG BioMed assessment submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "questionnaire_version",
    "answer_code_schema_version",
    "consent",
    "locale",
    "answers",
    "contact"
  ],
  "properties": {
    "contract_version": {
      "const": "assessment-submission/1.1.0"
    },
    "questionnaire_version": {
      "const": "questionnaire/2026-08-05-v19.4-phase1"
    },
    "answer_code_schema_version": {
      "const": "question-answer-codes/1.0.0"
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consent_version", "accepted_at", "accepted_item_ids"],
      "properties": {
        "consent_version": {
          "const": "consent/2026-08-05"
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "accepted_item_ids": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["data_use", "model_limitations", "non_medical_use"]
          },
          "allOf": [
            { "contains": { "const": "data_use" } },
            { "contains": { "const": "model_limitations" } },
            { "contains": { "const": "non_medical_use" } }
          ]
        }
      }
    },
    "locale": {
      "enum": ["zh-Hant", "en"]
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 76,
      "items": {
        "$ref": "#/$defs/answer"
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email"],
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        }
      }
    },
    "client_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "$defs": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "status", "value"],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "not": {
            "enum": ["consent_acknowledgement", "email"]
          }
        },
        "status": {
          "enum": ["answered", "unknown", "not_applicable"]
        },
        "value": {
          "oneOf": [
            { "type": "string", "maxLength": 256 },
            { "type": "number" },
            { "type": "boolean" },
            {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 96
              }
            },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
